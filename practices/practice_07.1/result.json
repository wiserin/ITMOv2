    {
      "parameters": {
        "jsCode": "const ctx = $('Prepare hunks').first().json;\nconst result = $input.first().json;\nlet answer = result.text ?? result.output ?? result.response?.text ?? result;\nif (typeof answer === 'string') {\n    answer = answer.trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'');\n    try { answer=JSON.parse(answer); } catch { throw new Error('Model did not return valid JSON'); }\n}\nif (!Array.isArray(answer.reviews)) throw new Error('Missing reviews array');\nconst reviews = new Map();\nfor (const r of answer.reviews) {\n    if (!Number.isInteger(r.id) || !ctx.blocks.some(b=>b.id===r.id) || reviews.has(r.id) || typeof r.comment!=='string' || !r.comment.trim()) throw new Error('Invalid or duplicate review block');\n    reviews.set(r.id,r.comment.trim());\n}\nif (reviews.size!==ctx.blocks.length) throw new Error('The model omitted one or more hunks');\nconst comments = ctx.blocks.map(b=>({path:b.path,line:b.line,side:b.side,body:`**AI review (${ctx.model})**\\n\\n${reviews.get(b.id)}`}));\nconst skipped = ctx.skipped.length ? '\\n\\nFiles without a text patch: '+ctx.skipped.join(', ') : '';\nreturn [{json:{...ctx,review:{commit_id:ctx.head_sha,event:'COMMENT',body:`AI review: ${ctx.model}. Checked ${comments.length} diff hunks.${skipped}`,comments}}}];"
      },
