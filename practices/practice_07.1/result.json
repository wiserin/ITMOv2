        0,
        144
      ],
      "webhookId": "0a71c841-8046-47fb-a138-960598f0e6c2",
      "credentials": {
        "githubApi": {
          "id": "VHEVDLxCmrDSy1Dv",
          "name": "GitHub account 79"
        }
