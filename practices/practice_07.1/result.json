    {
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nconst repo = p.repository?.full_name;\nif (!repo || !/^[\\w.-]+\\/[\\w.-]+$/.test(repo)) return [];\nlet number, source, secondary = false;\nif (p.action === 'opened' && p.pull_request) {\n    number = p.pull_request.number ?? p.number;\n    source = 'opened';\n} else if (p.action === 'created' && p.issue?.pull_request && p.comment) {\n    if (p.comment.user?.type === 'Bot') return [];\n    const cmd = (p.comment.body ?? '').trim();\n    if (!['/make_ai_review', '/make_other_ai_review'].includes(cmd)) return [];\n    if (!['OWNER','MEMBER','COLLABORATOR'].includes(p.comment.author_association)) return [];\n    number = p.issue.number;\n    source = cmd;\n    secondary = cmd === '/make_other_ai_review';\n} else { return []; }\nif (!Number.isInteger(number) || number < 1) return [];\nreturn [{json:{repository:repo, pr_number:number, source, secondary}}];"
      },
