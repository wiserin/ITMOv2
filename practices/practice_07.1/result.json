    {
      "parameters": {
        "jsCode": "const pr = $input.first().json;\nconst event = $('Normalize event').first().json;\nif (pr.state !== 'open') return [];\nif (!pr.id || !pr.head?.sha) throw new Error('Missing PR metadata');\nif (pr.changed_files > 100) throw new Error('Lab workflow supports up to 100 files per PR. Use a smaller PR.');\nreturn [{json:{...event, pr_id:String(pr.id), head_sha:pr.head.sha, lookup_id:event.secondary ? 'SECONDARY_BYPASS' : String(pr.id), model:event.secondary ? 'anthropic/claude-opus-4.5' : 'openai/gpt-5.2'}}];"
      },
