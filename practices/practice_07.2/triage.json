      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\nif (p.action !== 'opened' || !p.issue || p.issue.pull_request) return [];\nconst i=p.issue, repository=p.repository?.full_name;\nif (repository !== 'wiserin/ITMOv2' || !i.id || !Number.isInteger(i.number)) return [];\nreturn [{json:{repository,issue_id:String(i.id),issue_number:i.number,title:i.title,body:i.body ?? '',author:i.user?.login ?? '',first_time:i.author_association === 'NONE',created_at:i.created_at}}];"
