    {
      "parameters": {
        "jsCode": "const x=$input.first().json;\nconst labels=[\"bug\"];\nif (x.first_time) labels.push('first-time-contributor');\nlet comment=\"Спасибо за баг-репорт! Если возможно, приложите шаги воспроизведения, ожидаемый и фактический результат.\";\nif (comment && x.first_time) comment=`Привет @${x.author}! Рады вашему первому вкладу. [CONTRIBUTING.md](https://github.com/${x.repository}/blob/main/CONTRIBUTING.md)\\n\\n${comment}`;\nreturn [{json:{...x,labels,comment}}];"
