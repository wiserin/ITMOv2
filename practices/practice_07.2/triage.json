        "jsCode": "const ctx=$('Normalize issue').first().json;\nconst c=$input.first().json;\nconst valid=['bug','task','feature'].includes(c.type) && typeof c.confidence==='number' && c.confidence>=0.8 && c.confidence<=1;\nreturn [{json:{...ctx,type:valid?c.type:'unknown',confidence:c.confidence ?? 0}}];"
      },
