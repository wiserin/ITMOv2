    {
      "parameters": {
        "jsCode": "const x = $input.first().json;\nif (typeof x.title !== 'string') throw new Error('title is required');\nconst body = typeof x.body === 'string' ? x.body : '';\nreturn [{json:{title:x.title,body}}];"
      },
      "id": "69817e3f-e313-4080-8be7-b15692ef3f3e",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
