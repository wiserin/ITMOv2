      "id": "86c7a930-ccdc-4e8e-a77b-c16c8bf8b081",
      "name": "Weekly AI summary Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2160,
        304
      ],
      "credentials": {
        "openAiApi": {
          "id": "WuG2Jha90lQRWgSy",
          "name": "OpenAI account 73"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const x=$('Calculate delta').first().json;\nconst r=$input.first().json;\nconst note=r.text ?? r.output ?? r.response?.text;\nif(typeof note!=='string'||!note.trim()) throw new Error('AI summary missing');\nconst esc=v=>String(v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst fmt=n=>n===undefined||n===null?'—':n>0?'+'+n:String(n);\nconst metrics={issues_opened:'Открытые Issues',issues_closed:'Закрытые Issues',prs_opened:'Открытые PR',prs_merged:'Смерженные PR'};\nconst cell='padding:8px 12px;border:1px solid #ddd;text-align:left';\nconst tr=values=>'<tr>'+values.map(v=>`<td style=\"${cell}\">${esc(v)}</td>`).join('')+'</tr>';\nconst table=(headers,rows)=>'<table style=\"border-collapse:collapse;width:100%;margin-bottom:18px\"><thead><tr>'+headers.map(v=>`<th style=\"${cell};background:#eef2f6\">${esc(v)}</th>`).join('')+'</tr></thead><tbody>'+rows.map(tr).join('')+'</tbody></table>';\nlet html=`<div style=\"font-family:Arial,sans-serif;max-width:760px\"><h1>Еженедельная статистика</h1><p>${esc(x.repository)} · ${esc(x.week_start)} — ${esc(x.week_end)}</p>`;\nhtml+=table(['Метрика','Количество','Δ к прошлой неделе'],Object.entries(metrics).map(([k,v])=>[v,x.stats[k].total,fmt(x.delta?.[k]?.total)]));\nfor(const k of ['issues_opened','issues_closed']) {\n    html+=`<h2>${metrics[k]} — по типу</h2>`;\n    html+=table(['Тип','Количество','Δ'],Object.entries(x.stats[k].by_type).map(([t,n])=>[t,n,fmt(x.delta?.[k]?.by_type?.[t])]));\n}\nhtml+='<h2>По авторам</h2>';\nconst authors=[...new Set(Object.keys(metrics).flatMap(k=>[...Object.keys(x.stats[k].by_author),...Object.keys(x.previous?.[k]?.by_author??{})]))].sort();\nhtml+=authors.length?table(['Автор',...Object.values(metrics)],authors.map(a=>[a,...Object.keys(metrics).map(k=>{const n=x.stats[k].by_author[a]??0;const d=x.delta?x.delta[k].by_author[a]??0:null;return `${n} (${fmt(d)})`})])):'<p>Нет активности за период.</p>';\nif(!x.previous) html+='<p>Данные прошлой недели отсутствуют; Δ не рассчитана.</p>';\nhtml+=`<h2>AI-комментарий недели</h2><p>${esc(note).replace(/\\n/g,'<br>')}</p></div>`;\nreturn [{json:{...x,statistics_json:JSON.stringify(x.stats),subject:`GitHub report: ${x.week_start} — ${x.week_end}`,html}}];"
      },
