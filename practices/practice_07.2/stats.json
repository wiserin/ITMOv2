        "jsCode": "const repository = 'wiserin/ITMOv2';\nconst recipient = 'timofeytsep@gmail.com';\nconst weekOffset = 0;\nconst start = $now.setZone('Europe/Moscow').startOf('week').minus({weeks:weekOffset});\nconst end = start.plus({weeks:1});\nconst range = start.toUTC().toISO({suppressMilliseconds:true})+'..'+end.minus({seconds:1}).toUTC().toISO({suppressMilliseconds:true});\nreturn [{json:{repository,recipient,week_start:start.toISODate(),week_end:end.minus({days:1}).toISODate(),previous_week:start.minus({weeks:1}).toISODate(),range}}];"
      },
