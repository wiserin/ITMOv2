    {
      "parameters": {
        "jsCode": "const cfg=$('Report config').first().json;\nfunction get(name) {\n    const pages=$(name).all().map(x=>x.json.body ?? x.json);\n    if (!pages.length || pages.some(p=>!Array.isArray(p.items) || p.incomplete_results)) throw new Error('Incomplete GitHub results: '+name);\n    const unique=new Map();\n    for (const p of pages) for(const item of p.items) unique.set(item.id,item);\n    if (unique.size < pages[0].total_count) throw new Error('GitHub search truncated: '+name);\n    return [...unique.values()];\n}\nfunction type(i) {\n    const names=(i.labels ?? []).map(l=>l.name.toLowerCase());\n    if(names.includes('needs-triage')) return 'unknown';\n    const types=[names.includes('bug')?'bug':null,names.includes('task')?'task':null,(names.includes('feature-request') || names.includes('feature'))?'feature':null].filter(Boolean);\n    return types.length===1?types[0]:'unknown';\n}\nfunction group(items,issues) {\n    const by_author=Object.create(null), by_type={bug:0,task:0,feature:0,unknown:0};\n    for(const i of items) {\n        const a=i.user?.login ?? '(unknown)';\n        by_author[a]=(by_author[a] ?? 0)+1;\n        if(issues) by_type[type(i)]++;\n    }\n    return {total:items.length,by_author,...(issues?{by_type}:{})};\n}\nconst stats={issues_opened:group(get('Opened issues'),true),issues_closed:group(get('Closed issues'),true),prs_opened:group(get('Opened PRs'),false),prs_merged:group(get('Merged PRs'),false)};\nreturn [{json:{...cfg,stats}}];"
      },
