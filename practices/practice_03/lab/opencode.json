{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "openai/gpt-5",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama-local"
      },
      "models": {
        "local-coder:latest": { "name": "local-coder:latest" },
        "itmo-agent": { "name": "itmo-agent" }
      }
    }
  }
}
